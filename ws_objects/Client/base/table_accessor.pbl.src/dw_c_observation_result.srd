 column=(type=char(8) update=yes updatewhereclause=yes name=print_result_separator dbname="c_Observation_Result.print_result_separator" dbalias=".print_result_separator" )
 column=(type=char(24) update=yes updatewhereclause=yes name=unit_preference dbname="c_Observation_Result.unit_preference" dbalias=".unit_preference" )
