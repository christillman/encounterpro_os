 column=(type=char(80) updatewhereclause=yes name=observation_description dbname="c_Observation.description" dbalias=".description" )
 retrieve="  SELECT c_Observation_Result.observation_id,   
         c_Observation_Result.result_sequence,   
         c_Observation_Result.result_type,   
         c_Observation_Result.result_unit,   
         c_Observation_Result.result,   
         c_Observation_Result.result_amount_flag,   
         c_Observation_Result.print_result_flag,   
         c_Observation_Result.severity,   
         c_Observation_Result.abnormal_flag,   
         c_Observation_Result.specimen_type,   
         c_Observation_Result.specimen_amount,   
         c_Observation_Result.sort_sequence,   
         c_Observation_Result.status,   
         c_Observation_Result.last_updated,   
         c_Observation_Result.updated_by,   
         c_Observation_Result.external_source,   
         c_Observation_Result.property_id,   
         c_Observation_Result.service,   
         c_Observation_Result.print_result_separator,   
         c_Observation_Result.unit_preference,   
         c_Observation_Result.display_mask,   
         c_Observation_Result.property_address,   
         COALESCE(c_Observation_Result_Range.normal_range, c_Observation_Result.normal_range) as normal_range,   
         id=CAST(c_Observation_Result.id AS varchar(40)),   
         c_Observation.description  
    FROM c_Observation_Result inner join 
         c_Observation  on  c_Observation_Result.observation_id = c_Observation.observation_id
	LEFT OUTER JOIN c_Observation_Result_Range 
	ON c_Observation_Result_Range.observation_id = c_Observation_Result.observation_id
	AND c_Observation_Result_Range.result_sequence = c_Observation_Result.result_sequence
   WHERE ( ( c_Observation_Result.observation_id = :observation_id ) )    
" arguments=(("observation_id", string))  sort="observation_id A sort_sequence A result_sequence A " )
